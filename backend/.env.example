# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/furniture_store?schema=public"
# Public URLs of the two web apps (used in emails, CORS and redirects)
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Where uploaded media lives on disk (public/ and private/ folders are created inside)
MEDIA_ROOT=./storage
# Run scheduled jobs (stock expiry, email sending) inside this process.
# In production run them in a separate PM2 process (npm run start:jobs) and set this to false for the API.
RUN_JOBS=true
# In production Nginx serves private files via X-Accel-Redirect when true
NGINX_ACCEL=false

# --- Payments (MVP: test mode only) -------------------------------------
PAYMENTS_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FEATURE_EMI=false
SHIPPING_PROVIDER=manual
# Place names for unlisted pincodes: India Post's free public service, each answer saved in our database. "off" disables it.
PINCODE_LOOKUP=indiapost

# --- Email (Nodemailer) -------------------------------------------------
# Leave SMTP_HOST empty in development: emails are then written to
# storage/mail/ and their subjects (and OTP codes) printed in the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SSS Furniture <care@sssfurniture.co.in>"

# --- Google sign-in ("Continue with Google") -------------------------------
# From Google Cloud > Google Auth Platform > Clients (type: Web application).
# Add this Authorized redirect URI there: <STOREFRONT_URL>/api/store/auth/google/callback
# Leave either value empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storefront <-> backend shared secret --------------------------------
# Used for storefront cache refresh and for server-side rendering calls.
# Must match INTERNAL_SECRET in storefront/.env.local
REVALIDATE_URL=http://localhost:3000/api/revalidate
INTERNAL_SECRET=change-me-to-a-long-random-string

# --- Staff security -----------------------------------------------------
STAFF_2FA_REQUIRED=true
