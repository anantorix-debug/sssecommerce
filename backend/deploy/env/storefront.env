# Production settings for the storefront. Copy to /opt/sss-shop/storefront/.env.local
# NEXT_PUBLIC_* values are built into the app: rebuild after changing them.
API_INTERNAL_URL=http://127.0.0.1:4100
# Same value as INTERNAL_SECRET in backend/.env
INTERNAL_SECRET=CHANGE_ME
NEXT_PUBLIC_SITE_URL=https://shop.sssfurniture.co.in
NEXT_PUBLIC_BRAND_NAME="SSS Furniture"
