# Production settings for the API. Copy to /opt/sss-shop/backend/.env and fill in every CHANGE_ME.
# The API refuses to start with a weak INTERNAL_SECRET, a default database password,
# or non-https public addresses. Anything else still missing shows on the admin dashboard.
NODE_ENV=production
PORT=4100
DATABASE_URL="postgresql://sss_shop:CHANGE_ME_DB_PASSWORD@localhost:5432/sss_shop?schema=public"
STOREFRONT_URL=https://shop.sssfurniture.co.in
ADMIN_URL=https://shopadmin.sssfurniture.co.in
MEDIA_ROOT=./storage
RUN_JOBS=false
NGINX_ACCEL=true

# --- Payments ------------------------------------------------------------
# Test keys (rzp_test_…) with PAYMENTS_MODE=test take no real money.
# For real money: live keys (rzp_live_…) and PAYMENTS_MODE=live.
PAYMENTS_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Webhooks → https://shop.sssfurniture.co.in/api/webhooks/razorpay
# events: payment.captured, order.paid, payment.failed, refund.processed, refund.failed. Paste the secret you set there.
RAZORPAY_WEBHOOK_SECRET=
FEATURE_EMI=false
SHIPPING_PROVIDER=manual
PINCODE_LOOKUP=indiapost

# --- Email: needed for sign-in codes and order emails -------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SSS Furniture <care@sssfurniture.co.in>"

# --- Google sign-in -------------------------------------------------------
# In Google Cloud, add the redirect URI https://shop.sssfurniture.co.in/api/store/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storefront cache refresh ------------------------------------------------
# Straight to the storefront on this server, not through Nginx.
REVALIDATE_URL=http://127.0.0.1:3100/api/revalidate
# openssl rand -hex 32   (the same value goes in storefront/.env.local)
INTERNAL_SECRET=CHANGE_ME

STAFF_2FA_REQUIRED=true
