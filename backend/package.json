{
  "name": "aangan-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:jobs": "node dist/jobs-main.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx prisma/seed.ts --fresh",
    "setup:owner": "tsx prisma/create-owner.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/schedule": "6.1.3",
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "google-auth-library": "10.9.1",
    "nodemailer": "7.0.13",
    "pdfkit": "0.20.2",
    "qrcode": "1.5.4",
    "razorpay": "2.9.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "7.0.12",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
