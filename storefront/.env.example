# Backend address as seen from the storefront server (server-side rendering calls)
API_INTERNAL_URL=http://127.0.0.1:4000
# Must match INTERNAL_SECRET in backend/.env
INTERNAL_SECRET=change-me-to-a-long-random-string
# Public URL of this site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_BRAND_NAME="SSS Furniture"
